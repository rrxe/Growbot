.page-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
}

.eyebrow {
  color: #94a3b8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .2px;
}

.page-header h1 {
  margin: 4px 0 0;
  font-size: 24px;
  letter-spacing: -.3px;
}

.points-badge {
  padding: 7px 11px;
  border-radius: 10px;
  background: rgba(117, 169, 255, .1);
  border: 1px solid rgba(117, 169, 255, .18);
  color: #75a9ff;
  font-family: ui-monospace, monospace;
  font-size: 10px;
  font-weight: 800;
  white-space: nowrap;
}

.filter-tabs {
  display: flex;
  gap: 8px;
  margin: 18px 0 14px;
}

.filter-tabs button {
  border: 1px solid #24334a;
  background: #0f1724;
  color: #94a3b8;
  border-radius: 20px;
  padding: 8px 15px;
  font-size: 11px;
  font-weight: 800;
  transition: background .15s, color .15s, border-color .15s;
}

.filter-tabs button.active {
  background: #f5f9ff;
  color: #07101d;
  border-color: #f5f9ff;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.task-card {
  display: flex;
  align-items: center;
  gap: 11px;
  background: #0f1724;
  border: 1px solid #24334a;
  border-radius: 17px;
  padding: 13px;
  box-shadow: 0 6px 18px rgba(0,0,0,.14);
}

.task-avatar {
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  color: #07101d;
  font-weight: 900;
  font-size: 15px;
}

.task-content {
  min-width: 0;
  flex: 1;
}

.task-content strong,
.task-content span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-content strong {
  font-size: 12.5px;
}

.task-content span {
  color: #94a3b8;
  font-size: 10px;
  margin-top: 3px;
}

.task-progress-row {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 7px;
}

.task-progress-bar {
  flex: 1;
  height: 5px;
  border-radius: 4px;
  background: #1c2a3d;
  overflow: hidden;
}

.task-progress-bar > div {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #75a9ff, #75a9ff);
}

.task-progress-row small {
  flex: 0 0 auto;
  color: #718096;
  font-size: 9px;
  white-space: nowrap;
}

.task-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 7px;
}

.task-right > b {
  color: #75a9ff;
  font-family: ui-monospace, monospace;
  font-size: 11px;
}

.task-action {
  border: 0;
  border-radius: 10px;
  background: #f5f9ff;
  color: #07101d;
  padding: 8px 12px;
  font-size: 10.5px;
  font-weight: 900;
  min-width: 58px;
}

.task-action-upload {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  cursor: pointer;
  background: #91b7ff;
  color: #07101d;
}

.task-action-verify {
  background: #75a9ff;
  color: #07101d;
}

.task-action:disabled {
  opacity: .55;
}

.empty-state {
  min-height: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-icon {
  width: 48px;
  height: 48px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  background: rgba(117, 169, 255, .1);
  color: #75a9ff;
  font-size: 22px;
}

.empty-state strong {
  margin-top: 13px;
}

.empty-state p {
  color: #94a3b8;
  font-size: 11px;
  line-height: 1.7;
  max-width: 280px;
}

.task-desc {
  color: #94a3b8;
  font-size: 10px;
  line-height: 1.5;
  margin: 4px 0 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}


.adsgram-native-task-card {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr);
  gap: 9px 10px;
  align-items: center;
  margin-top: 15px;
  margin-bottom: 14px;
  padding: 12px;
  border-radius: 17px;
  background:
    radial-gradient(110% 130% at 100% 0%, rgba(117,169,255,.08), transparent 55%),
    #0f1724;
  border: 1px solid #24334a;
  box-shadow: 0 6px 18px rgba(0,0,0,.14);
}

.adsgram-native-task-badge {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: rgba(117,169,255,.1);
  border: 1px solid rgba(117,169,255,.18);
  color: #75a9ff;
  font-family: ui-monospace, monospace;
  font-size: 9px;
  font-weight: 900;
}

.adsgram-native-task-copy strong,
.adsgram-native-task-copy span {
  display: block;
}

.adsgram-native-task-copy strong {
  font-size: 12px;
}

.adsgram-native-task-copy span {
  margin-top: 3px;
  color: #94a3b8;
  font-size: 9px;
}

.adsgram-native-task-host {
  grid-column: 1 / -1;
  min-height: 54px;
  border-radius: 13px;
  overflow: hidden;
}

.adsgram-native-task-host adsgram-task {
  display: block;
  width: 100%;
  --adsgram-task-font-size: 12px;
  --adsgram-task-icon-size: 30px;
  --adsgram-task-icon-title-gap: 8px;
  --adsgram-task-icon-border-radius: 8px;
}
